---
import DocsLayout from "../layouts/DocsLayout.astro";
import CodeBlock from "../components/CodeBlock.astro";

const checkCommands = `considered check
considered check --json
considered check --sarif`;

const varianceCommand = `considered variance add \\
  --subject <path> \\
  --metric <metric> \\
  --kind <kind> \\
  --reason <reason>`;
---

<DocsLayout
  title="CLI reference"
  description="Command reference for the Considered CLI."
  current="/reference/"
>
  <article class="doc">
    <h1>CLI reference</h1>

    <h2><code>considered init</code></h2>
    <p>
      Writes a starter <code>.considered.yaml</code> to the repository root.
      Fails if the file already exists.
    </p>

    <h2><code>considered check</code></h2>
    <p>Evaluates the repository against the configuration.</p>
    <CodeBlock lang="bash" code={checkCommands} />

    <h2><code>considered instructions</code></h2>
    <p>
      Prints the configured free-form instructions, or
      <code>(No instructions provided)</code> when the property is absent.
    </p>

    <h2><code>considered variance add</code></h2>
    <p>
      Captures a metric value as an approved variance boundary and writes it to
      the configuration.
    </p>
    <CodeBlock lang="bash" code={varianceCommand} />
    <p>
      Add <code>--metric-reason &lt;reason&gt;</code> for an optional metric-specific
      explanation. Missing subject, metric, kind, and reason values are prompted
      for interactively.
    </p>

    <h2><code>considered version</code></h2>
    <p>Prints the CLI version. <code>--version</code> and <code>-v</code> are aliases.</p>

    <h2>Startup and usage errors</h2>
    <p>
      Running <code>considered</code> without a command prints usage to stderr and
      exits with status 2. Use <code>considered --help</code> or
      <code>considered --version</code> for a successful startup check.
      The bundled provider requires <code>considered-scc --json --root &lt;dir&gt;</code>;
      without arguments it prints <code>--json is required</code> and exits with status 2.
      These are application usage errors, not missing-executable errors.
    </p>

    <h2>Common flags</h2>
    <table>
      <thead>
        <tr>
          <th>Flag</th>
          <th>Meaning</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><code>--root &lt;dir&gt;</code></td>
          <td>For init, check, instructions, and variance add. Defaults to the current directory.</td>
        </tr>
        <tr>
          <td><code>--config &lt;file&gt;</code></td>
          <td>
            For check, instructions, and variance add. Defaults to
            <code>&lt;root&gt;/.considered.yaml</code>. An explicit relative path
            is resolved from the current working directory.
          </td>
        </tr>
      </tbody>
    </table>
  </article>
</DocsLayout>
